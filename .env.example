# ── RPC ───────────────────────────────────────────
# Base mainnet
RPC_URL=https://mainnet.base.org

# ── Wallets ───────────────────────────────────────
# Comma-separated private keys (NO 0x prefix needed if already present)
# Example: 0xabc123...,0xdef456...
PRIVATE_KEYS=0xkey1,0xkey2,0xkey3

# ── Gas Warfare ───────────────────────────────────
# How aggressively to bid above base fee (1.5 = 50% over)
GAS_MULTIPLIER=1.5
# Priority fee in gwei
PRIORITY_FEE_GWEI=2

# ── Engine Timing ─────────────────────────────────
# How often to poll for drop start (ms)
POLL_INTERVAL_MS=500
# Start firing this many ms before T-0 (negative = after)
PRE_TRIGGER_OFFSET_MS=500

# ── Storage ───────────────────────────────────────
QUEUE_FILE=./drops.json
LOG_FILE=./mint-log.jsonl
